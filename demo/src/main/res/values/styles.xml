<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="DefaultTv">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_bg</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textColor">@color/common_black</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="CustomTabLayout" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorHeight">4dp</item>
        <item name="tabPaddingBottom">20dp
        </item> <!-- Set the padding to adjust the space between text and indicator -->
    </style>

    <style name="SqTabText">
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <declare-styleable name="BlurView">
        <attr name="blurOverlayColor" format="color"/>
    </declare-styleable>

    <style name="HexagonStyle">
        <item name="cornerFamily">cut</item>
        <item name="cornerSizeTopLeft">10dp</item>
        <item name="cornerSizeTopRight">0%</item>
        <item name="cornerSizeBottomRight">50%</item>
    </style>

    <declare-styleable name="GradientView">
        <attr name="gradientColors" format="reference" />
        <attr name="gradientPositions" format="reference" />
        <attr name="gradientAngle" format="float" />
    </declare-styleable>

<!--    一定不能添加 windowTranslucentNavigation，否则导航栏是半透明：会强制启用半透明导航栏，即使你在代码中设置了完全透明，样式中的这个设置也会覆盖代码设置。-->
<!--    AlertDialog.AppCompat 无背景蒙层，Theme.MaterialComponents.Dialog 有背景蒙层-->
<!--    这个影响edge适配，非全屏不要设置 true:<item name="android:windowIsFloating">false</item>-->
    <style name="DialogFull" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <!--        <item name="android:windowFullscreen">true</item>-->
        <!--        <item name="android:windowTranslucentNavigation">true</item>-->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="MemberInviteText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:maxWidth">110dp</item>
        <item name="android:textColor">#222222</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textSize">10dp</item>
    </style>

    <style name="MemberInviteIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">9dp</item>
    </style>

    <style name="MemberInviteDash">
        <item name="android:layout_width">53dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:background">@drawable/member_invite_step_dash</item>
    </style>

    <!-- StateLayout -->
    <declare-styleable name="PageStateLayout">
        <attr name="psl_loadingDesc" format="string" />
        <attr name="psl_emptyDesc" format="string" />
        <attr name="psl_emptyActionDesc" format="string" />
        <attr name="psl_emptyIcon" format="reference" />
        <attr name="psl_errorDesc" format="string" />
        <attr name="psl_errorActionDesc" format="string" />
        <attr name="psl_errorIcon" format="reference" />
        <attr name="psl_alignOffset" format="dimension" />
        <attr name="psl_align">
            <flag name="top" value="0x01" />
            <flag name="bottom" value="0x02" />
            <flag name="center" value="0x04" />
        </attr>
    </declare-styleable>

</resources>