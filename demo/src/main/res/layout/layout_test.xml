<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="这是故事介绍这是故事介绍这是故事介绍这是故事介绍"
        android:textColor="@color/black"
        app:layout_constrainedWidth="true"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_bias="0"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/date_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/date_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:text="07:30"
        android:textColor="@color/light_blue_400"
        android:textSize="12dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@id/title_view"
        app:layout_constraintStart_toEndOf="@id/title_view"
        app:layout_constraintEnd_toStartOf="@id/action_view"
        app:layout_constraintTop_toTopOf="@id/title_view" />

    <Button
        android:id="@+id/action_view"
        android:text="开始"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_height="wrap_content" />

</androidx.constraintlayout.widget.ConstraintLayout>